<main class="shortener">
  <div id="shorturl" data-copy-container>
    {{#if link}}
      <div class="clipboard">
        <button 
          type="button"
          aria-label="{{t 'ui.copy'}}"
          data-ui-copy
          data-url="{{url}}"
        >
        {{> icons/copy}}
        </button>
        {{> icons/check}}
      </div>
      <h1 class="link"><button type="button" class="link-button" aria-label="{{t 'ui.copy_value' value1=link}}" title="{{t 'ui.copy_short_link'}}"
        data-ui-copy
        data-url="{{url}}"
      >
        {{link}}
      </button></h1>
    {{/if}}
    {{#unless link}}
        <h1>{{t "ui.cut_your_links"}} <span>{{t "ui.shorter"}}</span>.</h1>
    {{/unless}}
  </div>
  <form 
    id="shortener-form" 
    hx-post="/api/links" 
    hx-trigger="submit queue:none" 
    hx-target="closest main" 
    hx-swap="outerHTML" 
    autocomplete="off"
  >
    <div class="target-wrapper {{#if errors.target}}error{{/if}}">
      <input
        id="target"
        name="target"
        type="text"
        placeholder="{{t 'ui.paste_your_long_url'}}"
        aria-label="{{t 'ui.destination_url'}}"
        autofocus="true"
        data-lpignore="true"
        hx-preserve="true"
      />
      <button class="submit" type="submit" id="shortener-submit" aria-label="{{t 'ui.shorten_link'}}" title="{{t 'ui.shorten_link'}}">
        {{> icons/send}}
        {{> icons/spinner}}
      </button>
      {{#if errors.target}}<p class="error" data-error-field="target">{{errors.target}}</p>{{/if}}
      {{#unless errors}}
        {{#if error}}
          <p class="error">{{error}}</p>
        {{/if}}
      {{/unless}}
    </div>
    <label id="advanced" class="checkbox">
      <input 
        name="show_advanced" 
        type="checkbox" 
        data-ui-advanced
        {{#if show_advanced}}checked="true"{{/if}}
      />
      {{t "ui.show_advanced_options"}}
    </label>
    <section id="advanced-options" class="{{#unless show_advanced}}hidden{{/unless}}">
      <div class="advanced-input-wrapper">
        <label class="{{#if errors.domain}}error{{/if}}">
          {{t "ui.domain_3"}}
          <select 
            id="domain" 
            name="domain" 
            hx-preserve="true" 
            data-ui-domain
          >
            <option value={{default_domain}}>{{default_domain}}</option>
            {{#each linkDomains}}
              <option value={{address}}>{{address}}</option>
            {{/each}}
          </select>
          {{#if errors.domain}}<p class="error">{{errors.domain}}</p>{{/if}}
        </label>
        <label id="customurl-label" class="{{#if errors.customurl}}error{{/if}}">
          <span id="customurl-label-value" hx-preserve="true">{{default_domain}}/</span>
          <input
            type="text" 
            id="customurl" 
            name="customurl"
            aria-label="{{t 'ui.custom_address'}}"
            maxlength="64"
            placeholder="guide.pdf"
            hx-preserve="true"
            autocomplete="off" 
          />
          {{#if errors.customurl}}<p class="error">{{errors.customurl}}</p>{{/if}}
        </label>
        <label class="{{#if errors.password}}error{{/if}}">
          {{t "ui.password"}}
          <input 
            type="password" 
            id="password" 
            name="password" 
            placeholder="{{t 'ui.password_2'}}"
            hx-preserve="true" 
            autocomplete="new-password"
          />
          {{#if errors.password}}<p class="error">{{errors.password}}</p>{{/if}}
        </label>
      </div>
      <div class="advanced-input-wrapper schedule-fields">
        {{> date_time_field name="starts_at" value=starts_at_input label=(t "schedule.start") choose=(t "schedule.choose_start") empty=(t "schedule.immediately") error=errors.starts_at}}
        {{> date_time_field name="ends_at" value=ends_at_input label=(t "schedule.end") choose=(t "schedule.choose_end") empty=(t "schedule.no_end") error=errors.ends_at}}
      </div>
      <div class="advanced-input-wrapper">
        <label class="description {{#if errors.description}}error{{/if}}">
          {{t "ui.description"}}
          <input 
            type="text" 
            id="description" 
            name="description" 
            placeholder="{{t 'ui.description_2'}}"
            hx-preserve="true" 
          />
          {{#if errors.description}}<p class="error">{{errors.description}}</p>{{/if}}
        </label>
      </div>
      {{> campaign}}
    </section>
  </form>
</main>
