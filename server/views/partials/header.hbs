<header class="site-header">
  <div class="logo-wrapper">
    <a class="logo nav" href="/" title="{{t 'ui.homepage'}}">
      <img src="/images/logo.png" alt="" width="18" height="24" />
      <span class="site-name">{{site_name}}</span>
    </a>
    <ul class="logo-links">
      <li>
        <a class="nav" href="https://github.com/thedevs-network/kutt" target="_blank" rel="noopener noreferrer" title="GitHub">
          GitHub
        </a>
      </li>
      {{#if report_email}}
        <li>
          <a class="nav" href="/report" title="{{t 'ui.report_abuse'}}">
            {{t "ui.report"}}
          </a>
        </li>
      {{/if}}
    </ul>
  </div>
  <nav aria-label="{{t 'ui.account'}}">
    <ul>
      <li>
        <form action="/language" method="post" class="language-selector">
          <input type="hidden" name="return_to" value="{{locale_return}}" />
          <label for="site-language">{{t "locale.language"}}</label>
          <select id="site-language" name="locale">
            {{#each languages}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <button type="submit" title="{{t 'locale.apply'}}" aria-label="{{t 'locale.apply'}}">{{> icons/check}}</button>
        </form>
      </li>
      {{#unless user}}
        {{#unless login_disabled}}
          <li>
            <a class="button primary" href="/login" title="{{login_title}}">
              {{login_label}}
            </a>
          </li>
        {{/unless}}
      {{/unless}}
      {{#if user}}
        <li>
          <a class="button primary" href="/settings" title="{{t 'ui.settings'}}">
            <span>{{> icons/cog}}</span>
            {{t "ui.settings"}}
          </a>
        </li>
        {{#if isAdmin}}
          <li>
            <a class="button secondary" href="/admin" title="{{t 'ui.admin'}}">
              <span>{{> icons/shield}}</span>
              {{t "ui.admin"}}
            </a>
          </li>
        {{/if}}
        <li>
          <a class="nav" href="/logout" title="{{t 'ui.log_out'}}">
            {{t "ui.log_out"}}
          </a>
        </li>
      {{/if}}
    </ul>
  </nav>
</header>
