<section id="apikey-wrapper">
  <h2>{{t "ui.legacy_api_key"}}</h2>
  <p>
    {{t "ui.in_additional_to_this_website_you_can_use_the_api_to"}}
    <a href="https://docs.kutt.to" title="{{t 'ui.api_docs'}}" target="_blank">
      {{t "ui.read_api_docs"}}
    </a>
  </p>
  <div id="apikey" data-copy-container>
    {{#if user.apikey}}
      <div class="clipboard small">
        <button 
          type="button"
          aria-label="{{t 'ui.copy'}}"
          data-ui-copy
          data-url="{{user.apikey}}"
        >
        {{> icons/copy}}
        </button>
        {{> icons/check}}
      </div>
      <p 
        data-ui-copy
        data-url="{{user.apikey}}"
      >
        {{user.apikey}}
      </p>
    {{/if}}
    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}
  </div>
  <form 
    hx-post="/api/auth/apikey"
    id="generate-apikey" 
    hx-target="#apikey-wrapper" 
    hx-swap="outerHTML"
  >
    <button type="submit" class="secondary">
      <span>{{> icons/zap}}</span>
      <span>{{> icons/spinner}}</span>
      {{#if user.apikey}}{{t "token.regenerate"}}{{else}}{{t "token.generate"}}{{/if}}
    </button>
  </form>
</section>
