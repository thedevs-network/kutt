<table id="domains-table" hx-swap-oob="true">
  <thead>
    <tr>
      <th class="domain">{{t "ui.domain"}}</th>
      <th class="homepage">{{t "ui.homepage"}}</th>
      <th class="actions"></th>
    </tr>
  </thead>
  <tbody>
    {{#if domains}}
      {{#each domains}}
        <tr>
          <td class="domain">
            <a href="/settings/domain-sharing/{{id}}" title="{{t 'domain_grants.title'}}">{{address}}</a>
          </td>
          <td class="homepage">
            {{homepage}}
          </td>
          <td class="actions">
            <button 
              type="button"
              class="action delete" 
              aria-label="{{t 'ui.delete_domain_value' value1=address}}"
              title="{{t 'ui.delete_domain_2'}}"
              data-ui-open-dialog="domain-dialog"
              hx-get="/confirm-domain-delete" 
              hx-target="#domain-dialog .content-wrapper" 
              hx-indicator="#domain-dialog" 
              hx-vals='{"id":"{{id}}"}'
            >
              {{> icons/trash}}
            </button>
          </td>
        </tr>
      {{/each}}
    {{else}}
      <tr>
        <td class="no-entry">
          {{t "ui.no_domains_yet"}}
        </td>
      </tr>
    {{/if}}
  </tbody>
</table>
