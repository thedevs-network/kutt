<form 
  id="add-domain"
  hx-post="/api/domains"
  hx-sync="this:abort"
  hx-swap="outerHTML settle:0"
  data-ui-domain-save
>
  <div class="inputs">
    <label class="{{#if errors.address}}error{{/if}}">
      {{t "ui.address"}}
      <input 
        id="address" 
        name="address" 
        type="text" 
        placeholder="{{t 'ui.yoursite_com'}}"
        required="true" 
        hx-preserve="true" 

      />
      {{#if errors.address}}<p class="error">{{errors.address}}</p>{{/if}}
    </label>
    <label class="{{#if errors.homepage}}error{{/if}}">
      {{t "ui.homepage_optional_2"}}
      <input 
        id="homepage" 
        name="homepage" 
        placeholder="{{t 'ui.homepage_url'}}"
        type="text" 
        hx-preserve="true" 

      />
      {{#if errors.homepage}}<p class="error">{{errors.homepage}}</p>{{/if}}
    </label>
  </div>
  {{#if domain_verification}}
    <input type="hidden" name="proof" value="{{domain_verification.proof}}" />
    <p role="status">{{verification_notice}}</p>
    <dl class="domain-verification">
      <dt>{{t "ui.dns_record_type"}}</dt><dd>{{t "ui.txt"}}</dd>
      <dt>{{t "ui.record_name"}}</dt><dd data-copy-container><code>{{domain_verification.record_name}}</code>
        <button type="button" aria-label="{{t 'ui.copy_dns_record_name'}}" title="{{t 'ui.copy_dns_record_name'}}" data-url="{{domain_verification.record_name}}" data-ui-copy>{{> icons/copy}}</button>
      </dd>
      <dt>{{t "ui.record_value"}}</dt><dd data-copy-container><code>{{domain_verification.record_value}}</code>
        <button type="button" aria-label="{{t 'ui.copy_dns_record_value'}}" title="{{t 'ui.copy_dns_record_value'}}" data-url="{{domain_verification.record_value}}" data-ui-copy>{{> icons/copy}}</button>
      </dd>
      <dt>{{t "ui.expires"}}</dt><dd>{{date domain_verification.expires_at}}</dd>
    </dl>
  {{/if}}
  <p>
    <small>
      {{t "ui.if_you_leave_homepage_empty"}} <b>{{t "ui.yoursite_com"}}</b> {{t "ui.will_be_redirected_to"}} <b>{{default_domain}}</b>.
    </small>
  </p>
  <div class="buttons-wrapper">
    <button type="button" data-ui-domain-cancel>
      {{t "ui.cancel"}}
    </button>
    <button type="submit" class="primary">
      <span>{{> icons/plus}}</span>
      {{#if domain_verification}}{{t "ui.verify_ownership"}}{{else}}{{t "ui.add_domain"}}{{/if}}
    </button>
  </div>
  {{> icons/spinner}}
  {{#unless errors}}
    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}
  {{/unless}}
</form>
