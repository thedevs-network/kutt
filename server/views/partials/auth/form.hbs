<form id="login-signup" hx-post="/api/auth/login" hx-swap="outerHTML">
  {{#unless disallow_login_form}}
    <label class="{{#if errors.email}}error{{/if}}">
      {{t "ui.email_address"}}
      <input
        name="email"
        id="email"
        type="email"
        autofocus="true"
        placeholder="{{t 'ui.email_address_2'}}"
        hx-preserve="true"
      />
      {{#if errors.email}}<p class="error">{{errors.email}}</p>{{/if}}
    </label>
    <label class="{{#if errors.password}}error{{/if}}">
      {{t "ui.password"}}
      <input
        name="password"
        id="password"
        type="password"
        placeholder="{{t 'ui.password_2'}}"
        hx-preserve="true"
      />
      {{#if errors.password}}<p class="error">{{errors.password}}</p>{{/if}}
    </label>
    <div class="buttons-wrapper">
      <button 
        type="submit" 
        class="primary login {{#unless registration_enabled}}full{{/unless}}"
      >
        <span>{{> icons/login}}</span>
        <span>{{> icons/spinner}}</span>
        {{t "ui.log_in"}}
      </button>
      {{#if registration_enabled}}
          <button 
            type="button"
            class="secondary signup" 
            hx-post="/api/auth/signup" 
            hx-target="#login-signup" 
            hx-trigger="click" 
            hx-indicator="#login-signup" 
            hx-swap="outerHTML"
            hx-sync="closest form"
            data-ui-signup
          >
              <span>{{> icons/new_user}}</span>
              <span>{{> icons/spinner}}</span>
              {{t "ui.sign_up"}}
          </button>
      {{/if}}
    </div>
  {{/unless}}
  {{#if oidc_enabled}}
    <div class="buttons-wrapper">
      <a class="button secondary full" href="/login/oidc" title="{{t 'ui.login_with_oidc'}}">
        <span>{{> icons/key}}</span>
        {{oidc_button_text}}
      </a>
    </div>
  {{/if}}
  {{#unless disallow_login_form}}
    {{#if mail_enabled}}
      <a class="forgot-password" href="/reset-password" title="{{t 'ui.reset_password'}}">{{t "ui.forgot_your_password"}}</a>
    {{/if}}
  {{/unless}}
  {{#unless errors}}
    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}
  {{/unless}}
</form>
