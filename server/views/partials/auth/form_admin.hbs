<form id="login-signup" hx-post="/api/auth/create-admin" hx-swap="outerHTML">
  <h2 class="admin-form-title">
    {{t "ui.create_an_admin_account_first"}}
  </h2>
  <label class="{{#if errors.email}}error{{/if}}">
    {{t "ui.email_address"}}
    <input
      name="email"
      id="email"
      type="email"
      autofocus="true"
      placeholder="{{t 'ui.email_address_2'}}"
      hx-preserve="true"
    />
    {{#if errors.email}}<p class="error">{{errors.email}}</p>{{/if}}
  </label>
  <label class="{{#if errors.password}}error{{/if}}">
    {{t "ui.password"}}
    <input
      name="password"
      id="password"
      type="password"
      placeholder="{{t 'ui.password_2'}}"
      hx-preserve="true"
    />
    {{#if errors.password}}<p class="error">{{errors.password}}</p>{{/if}}
  </label>
  <div class="buttons-wrapper admin-form">
    <button type="submit" class="secondary full">
      <span>{{> icons/new_user}}</span>
      <span>{{> icons/spinner}}</span>
      {{t "ui.create_admin_account"}}
    </button>
  </div>
  {{#unless errors}}
    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}
  {{/unless}}
</form>