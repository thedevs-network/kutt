<div class="content">
  <h2>{{t "ui.move_link_to_trash"}}</h2>
  <p>
    {{t "dialog.trash_link" value=link}}
  </p>
  <div class="buttons">
    <button type="button" data-ui-close-dialog>{{t "ui.cancel"}}</button>
    <button 
      type="button"
      class="danger confirm" 
      hx-delete="/api/links/{id}" 
      hx-ext="path-params" 
      hx-vals='{"id":"{{id}}"}' 
      hx-target="closest .content" 
      hx-swap="none" 
      hx-indicator="closest .content"
      hx-select-oob="#dialog-error"
    >
      <span>{{> icons/trash}}</span>
      {{t "ui.move_to_trash"}}
    </button>
    {{> icons/spinner}}
  </div>
  <div id="dialog-error">
    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}
  </div>
</div>
