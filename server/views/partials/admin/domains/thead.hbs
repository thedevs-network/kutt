<thead>
  {{> admin/table_tab title='domains'}}
  <tr class="controls domains-controls with-filters">
    <th class="filters">
      <div>
        <div class="search-input-wrapper">
          <input 
            id="search" 
            name="search" 
            type="text" 
            placeholder="{{t 'ui.search_domain'}}" aria-label="{{t 'ui.search_domains'}}"
            class="table-input search admin" 
            data-ui-search
            data-ui-reset-nav="keyup"
            value="{{query.search}}"
          />
          <button 
            type="button" 
            aria-label="{{t 'ui.clear_search'}}"
            class="clear" 
            data-ui-clear-search
          >
            {{> icons/x}}
          </button>
        </div>
        <div class="search-input-wrapper">
          <input 
            id="search_user" 
            name="user" 
            type="text" 
            placeholder="{{t 'ui.search_user'}}" aria-label="{{t 'ui.search_users'}}"
            class="table-input search admin" 
            data-ui-search
            data-ui-reset-nav="keyup"
            value="{{query.user}}"
          />
          <button 
            type="button" 
            aria-label="{{t 'ui.clear_user'}}"
            class="clear" 
            data-ui-clear-search
          >
            {{> icons/x}}
          </button>
        </div>
        <select id="domains-select-banned" name="banned" class="table-input ban" data-ui-reset-nav="change" aria-label="{{t 'ui.banned_status'}}">
          <option value="" selected>{{t "ui.banned_2"}}</option>
          <option value="true">{{t "ui.banned"}}</option>
          <option value="false">{{t "ui.not_banned"}}</option>
        </select>
      </div>
      <div>
        <select id="domains-select-links" name="links" class="table-input links" data-ui-reset-nav="change" aria-label="{{t 'ui.link_ownership'}}">
          <option value="" selected>{{t "ui.links_2"}}</option>
          <option value="true" {{#ifEquals query.links 'true'}}selected{{/ifEquals}}>{{t "ui.with_links"}}</option>
          <option value="false" {{#ifEquals query.links 'true'}}selected{{/ifEquals}}>{{t "ui.no_links"}}</option>
        </select>
        <select id="domains-select-owner" name="owner" class="table-input owner" data-ui-reset-nav="change" aria-label="{{t 'ui.domain_owner_type'}}">
          <option value="" selected>{{t "ui.owner_2"}}</option>
          <option value="true" {{#ifEquals query.owner 'true'}}selected{{/ifEquals}}>{{t "ui.with_owner"}}</option>
          <option value="false" {{#ifEquals query.owner 'true'}}selected{{/ifEquals}}>{{t "ui.no_owner"}}</option>
        </select>
        <input id="total" name="total" type="hidden" value="{{total}}" />
        <input id="limit" name="limit" type="hidden" value="10" />
        <input id="skip" name="skip" type="hidden" value="0" />
        {{> list_sort profile='domains' state=query}}
        <button 
          class="table primary"
          data-ui-open-dialog="admin-table-dialog"
          hx-get="/add-domain" 
          hx-target="#admin-table-dialog .content-wrapper" 
          hx-indicator="#admin-table-dialog"
        >
          <span>{{> icons/plus}}</span>
          {{t "ui.add_domain"}}
        </button>
      </div>
    </th>
    {{> admin/table_nav}}
  </tr>
  <tr class="table-columns">
    <th class="domains-id" scope="col">{{t "ui.id"}}</th>
    <th class="domains-address" scope="col">{{t "ui.address_3"}}</th>
    <th class="domains-homepage" scope="col">{{t "ui.homepage"}}</th>
    <th class="domains-created-at" scope="col">{{t "ui.created_at"}}</th>
    <th class="domains-links-count" scope="col">{{t "ui.total_links"}}</th>
    <th class="domains-actions" scope="col"></th>
  </tr>
</thead>
