<td class="actions domains-actions">
  <a class="button action" href="/settings/domain-sharing/{{uuid}}" aria-label="{{t 'domain_grants.manage_for' domain=address}}" title="{{t 'domain_grants.title'}}">{{> icons/key}}</a>
  {{#if banned}}
    <a class="button action banned" href="/admin/moderation/domain/{{id}}" aria-label="{{t 'moderation.remove_for' value=address}}" title="{{t 'moderation.remove'}}">
      {{> icons/stop}}
    </a>
  {{/if}}
  {{#unless banned}}
    <button 
      class="action ban"
      type="button"
      aria-label="{{t 'ui.ban_domain_value' value1=address}}"
      title="{{t 'ui.ban_domain_2'}}"
      data-ui-open-dialog="admin-table-dialog"
      hx-get="/confirm-domain-ban" 
      hx-target="#admin-table-dialog .content-wrapper" 
      hx-indicator="#admin-table-dialog" 
      hx-vals='{"id":"{{id}}"}'
    >
      {{> icons/stop}}
    </button>
  {{/unless}}
  <button 
    class="action delete"
    type="button"
    aria-label="{{t 'ui.delete_domain_value' value1=address}}"
    title="{{t 'ui.delete_domain_2'}}"
    data-ui-open-dialog="admin-table-dialog"
    hx-get="/confirm-domain-delete-admin" 
    hx-target="#admin-table-dialog .content-wrapper" 
    hx-indicator="#admin-table-dialog" 
    hx-vals='{"id":"{{id}}"}'
  >
    {{> icons/trash}}
  </button>
</td>
