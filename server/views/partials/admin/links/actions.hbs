<td class="actions">
  {{#if password}}
    <button class="action password" disabled="true" aria-label="{{t 'ui.password_protected'}}" data-tooltip="{{t 'ui.password_protected'}}">
      {{> icons/key}}
    </button>
  {{/if}}
  {{#if banned}}
    <a class="button action banned" href="/admin/moderation/link/{{id}}" aria-label="{{t 'moderation.remove_for' value=link.address}}" title="{{t 'moderation.remove'}}">
      {{> icons/stop}}
    </a>
  {{/if}}
  <a
    class="button action stats"
    href="/stats?id={{id}}"
    title="{{t 'ui.statistics'}}"
    aria-label="{{t 'ui.statistics_for_value' value1=link.address}}"
  >
    {{> icons/chart}}
  </a>
  <button
    class="action qrcode"
    type="button"
    aria-label="{{t 'ui.qr_code_for_value' value1=link.address}}"
    title="{{t 'ui.qr_code'}}"
    data-ui-qr-dialog="admin-table-dialog"
    data-url="{{link.url}}"
  >
    {{> icons/qrcode}}
  </button>
  <button 
    class="action edit"
    id="edit-opener-{{id}}"
    type="button"
    aria-label="{{t 'ui.edit_value' value1=link.address}}"
    title="{{t 'ui.edit_link'}}"
    hx-trigger="click queue:none"
    hx-ext="path-params"
    hx-get="/admin/link/edit/{id}" 
    hx-vals='{"id":"{{id}}"}'
    hx-swap="beforeend settle:0ms"
    hx-target="next tr.edit"
    hx-indicator="next tr.edit"
    hx-sync="this:drop"
    data-ui-edit-toggle
  >
    {{> icons/pencil}}
  </button>
  {{#unless banned}}
    <button 
      class="action ban"
      type="button"
      aria-label="{{t 'ui.ban_value' value1=link.address}}"
      title="{{t 'ui.ban_link'}}"
      data-ui-open-dialog="admin-table-dialog"
      hx-get="/confirm-link-ban" 
      hx-target="#admin-table-dialog .content-wrapper" 
      hx-indicator="#admin-table-dialog" 
      hx-vals='{"id":"{{id}}"}'
    >
      {{> icons/stop}}
    </button>
  {{/unless}}
  <button 
    class="action delete"
    type="button"
    aria-label="{{t 'ui.move_value_to_trash' value1=link.address}}"
    title="{{t 'ui.move_to_trash'}}"
    data-ui-open-dialog="admin-table-dialog"
    hx-get="/confirm-link-delete" 
    hx-target="#admin-table-dialog .content-wrapper" 
    hx-indicator="#admin-table-dialog" 
    hx-vals='{"id":"{{id}}"}'
  >
    {{> icons/trash}}
  </button>
</td>
