<td class="content">
  {{#if id}}
    <form 
      id="edit-form-{{id}}"
      method="post" action="/api/links/admin/{{id}}"
      hx-patch="/api/links/admin/{id}"
      hx-ext="path-params"
      hx-vals='{"id":"{{id}}"}' 
      hx-select="#edit-form-{{id}}"
      hx-swap="outerHTML settle:0ms"
      hx-sync="this:replace"
      class="{{class}}"
    >
      <div>
        <label class="{{#if errors.target}}error{{/if}}">
          {{t "ui.target"}}
          <input 
            id="edit-target-{{id}}"
            name="target" 
            type="text" 
            placeholder="{{t 'ui.target_2'}}"
            required="true"
            value="{{target}}"
            hx-preserve="true"
          />
          {{#if errors.target}}<p class="error">{{errors.target}}</p>{{/if}}
        </label>
        <label class="{{#if errors.address}}error{{/if}}">
          <span id="edit-link-domain-{{id}}" hx-preserve="true">{{domain}}/</span>
          <input 
            id="edit-address-{{id}}"
            name="address" 
            type="text" 
            placeholder="guide.pdf"
            maxlength="64"
            required="true"
            value="{{address}}"
            hx-preserve="true"
          />
          {{#if errors.address}}<p class="error">{{errors.address}}</p>{{/if}}
        </label>
        <label class="{{#if errors.password}}error{{/if}}">
          {{t "ui.password"}}
          <input 
            id="edit-password-{{id}}"
            name="password" 
            type="password" 
            placeholder="{{t 'ui.password_2'}}"
            value="{{#if password}}••••••••{{/if}}"
            hx-preserve="true"
          />
          {{#if errors.password}}<p class="error">{{errors.password}}</p>{{/if}}
        </label>
      </div>
      <div>
        <label class="{{#if errors.description}}error{{/if}}">
          {{t "ui.description"}}
          <input 
            id="edit-description-{{id}}"
            name="description" 
            type="text" 
            placeholder="{{t 'ui.description_2'}}"
            value="{{description}}"
            hx-preserve="true"
          />
          {{#if errors.description}}<p class="error">{{errors.description}}</p>{{/if}}
        </label>
        <label class="{{#if errors.expire_in}}error{{/if}}">
          {{t "ui.expire_in"}}
          <input 
            id="edit-expire_in-{{id}}"
            name="expire_in" 
            type="text" 
            placeholder="{{t 'ui.2_minutes_hours_days'}}"
            value="{{relative_expire_in}}"
          />
          <input type="hidden" name="expiry_snapshot" value="{{expiry_snapshot}}" />
          {{#if error}}<small>{{t "ui.current_expiry"}} {{#if expire_in}}{{expire_in}}{{else}}{{t "ui.none"}}{{/if}}</small>{{/if}}
          {{#if errors.expire_in}}<p class="error">{{errors.expire_in}}</p>{{/if}}
        </label>
      </div>
      {{> campaign}}
      <div>
        <button 
          type="button"
          data-ui-edit-close="{{id}}"
        >
          {{t "ui.close"}}
        </button>
        <button type="submit" class="primary" id="edit-submit-{{id}}">
          <span class="reload">
            {{> icons/reload}}
          </span>
          <span class="loader">
            {{> icons/spinner}}
          </span>
          {{t "ui.update"}}
        </button>
      </div>
      <div class="response">
        {{#if error}}
          {{#unless errors}}
            <p class="error">{{error}}</p>
          {{/unless}}
        {{else if success}}
          <p class="success">{{success}}</p>
        {{/if}}
      </div>
      <template>
        {{> admin/links/tr}}
      </template>
    </form>
  {{else}}
    <p class="no-data">{{t "ui.no_link_was_found"}}</p>
  {{/if}}
</td>
