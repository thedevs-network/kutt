<thead>
  {{> admin/table_tab title='links'}}
  <tr class="controls links-controls with-filters">
    <th class="filters">
      <div>
        <div class="search-input-wrapper">
          <input 
            id="search" 
            name="search" 
            type="text" 
            placeholder="{{t 'ui.search_link'}}" aria-label="{{t 'ui.search_links'}}"
            class="table-input search admin" 
            data-ui-search
            data-ui-reset-nav="keyup"
            value="{{query.search}}"
          />
          <button 
            type="button" 
            aria-label="{{t 'ui.clear_search'}}"
            class="clear" 
            data-ui-clear-search
          >
            {{> icons/x}}
          </button>
        </div>
        <div class="search-input-wrapper">
          <input 
            id="search_domain" 
            name="domain" 
            type="text" 
            placeholder="{{t 'ui.search_domain'}}" aria-label="{{t 'ui.search_domains'}}"
            class="table-input search admin" 
            data-ui-search
            data-ui-reset-nav="keyup"
            value="{{query.domain}}"
          />
          <button 
            type="button" 
            aria-label="{{t 'ui.clear_domain_search'}}"
            class="clear" 
            data-ui-clear-search
          >
            {{> icons/x}}
          </button>
        </div>
        <div class="search-input-wrapper">
          <input 
            id="search_user" 
            name="user" 
            type="text" 
            placeholder="{{t 'ui.search_user'}}" aria-label="{{t 'ui.search_users'}}"
            class="table-input search admin" 
            data-ui-search
            data-ui-reset-nav="keyup"
            value="{{query.user}}"
          />
          <button 
            type="button" 
            aria-label="{{t 'ui.clear_user_search'}}"
            class="clear" 
            data-ui-clear-search
          >
            {{> icons/x}}
          </button>
        </div>
      </div>
      <div>
        <select 
          id="links-select-banned"
          name="banned"
          class="table-input ban"
          data-ui-reset-nav="change"
         aria-label="{{t 'ui.banned_status'}}">
          <option value="" selected>{{t "ui.banned_2"}}</option>
          <option value="true">{{t "ui.banned"}}</option>
          <option value="false">{{t "ui.not_banned"}}</option>
        </select>
        <select 
          id="links-select-anonymous"
          name="anonymous"
          class="table-input anonymous"
          data-ui-reset-nav="change"
         aria-label="{{t 'ui.link_owner_type'}}">
          <option value="">{{t "ui.anonymous"}}</option>
          <option value="true" {{#ifEquals query.anonymous 'true'}}selected{{/ifEquals}}>{{t "ui.anonymous_2"}}</option>
          <option value="false" {{#ifEquals query.anonymous 'false'}}selected{{/ifEquals}}>{{t "ui.user"}}</option>
        </select>
        <select 
          id="links-select-domain"
          name="has_domain"
          class="table-input has_domain"
          data-ui-reset-nav="change"
         aria-label="{{t 'ui.custom_domain'}}">
          <option value="">{{t "ui.domain_2"}}</option>
          <option value="true" {{#ifEquals query.has_domain 'true'}}selected{{/ifEquals}}>{{t "ui.with_domain"}}</option>
          <option value="false" {{#ifEquals query.has_domain 'false'}}selected{{/ifEquals}}>{{t "ui.no_domain"}}</option>
        </select>
        <input id="total" name="total" type="hidden" value="{{total}}" />
        <input id="limit" name="limit" type="hidden" value="10" />
        <input id="skip" name="skip" type="hidden" value="0" />
        {{> list_sort profile='links' state=query}}
      </div>
    </th>
    {{> admin/table_nav}}
  </tr>
  <tr class="table-columns">
    <th class="original-url" scope="col">{{t "ui.original_url"}}</th>
    <th class="created-at" scope="col">{{t "ui.created_at"}}</th>
    <th class="short-link" scope="col">{{t "ui.short_link"}}</th>
    <th class="views" scope="col">{{t "ui.views"}}</th>
    <th class="actions" scope="col"></th>
  </tr>
</thead>
