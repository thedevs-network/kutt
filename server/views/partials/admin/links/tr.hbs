<tr id="tr-{{id}}" {{#if swap_oob}}hx-swap-oob="true"{{/if}}>
  <td class="original-url right-fade">
    <span class="table-field-label" aria-hidden="true">{{t "ui.original_url_owner"}}</span>
    <a href="{{target}}" title="{{target}}" target="_blank" rel="noopener noreferrer">
      {{target}}
    </a>
    <p class="description">
      {{t "ui.by"}}
      {{~#if user_id~}}
        <button type="button" class="link-button" data-focus-after="#tab-users" aria-label="{{t 'ui.view_user'}}"
          data-tooltip="{{t 'ui.view_user'}}"
          hx-get="/api/users/admin"
          hx-target="closest table"
          hx-swap="outerHTML settle:0ms"
          hx-sync="this:replace"
          hx-indicator="closest table"
          hx-vals='{"search":"{{email}}"}'
        >
          {{email}}
        </button>
        {{#ifEquals @root.query.user email}}
        {{else}}
          &nbsp;(
          <button type="button" class="link-button" data-focus-after="#tab-links" aria-label="{{t 'ui.view_links_by_this_user'}}"
            data-tooltip="{{t 'ui.view_links_by_this_user'}}"
            hx-get="/api/links/admin"
            hx-target="closest table"
            hx-swap="outerHTML settle:0ms"
            hx-sync="this:replace"
            hx-indicator="closest table"
            hx-vals='{"user":"{{email}}"}'
          >
            {{t "ui.view_links_2"}}
          </button>)
        {{/ifEquals}}
      {{~else~}}
        <button type="button" class="link-button" data-focus-after="#tab-links" aria-label="{{t 'ui.view_anonymous_links'}}"
          data-tooltip="{{t 'ui.view_anonymous_links'}}"
          hx-get="/api/links/admin"
          hx-target="closest table"
          hx-swap="outerHTML settle:0ms"
          hx-sync="this:replace"
          hx-indicator="closest table"
          hx-vals='{"anonymous":"true"}'
        >
          {{t "ui.anonymous_2"}}
        </button>
      {{~/if~}}
      &nbsp;{{~#if description~}}· {{description}}{{~/if}}
    </p>
  </td>
  <td class="created-at">
    <span class="table-field-label" aria-hidden="true">{{t "ui.created_at"}}</span>
    {{relative_created_at}}
    {{#if relative_expire_in}}
      <p class="description">
        {{t "ui.expires_in_value" value1=relative_expire_label}}
      </p>
    {{/if}}
  </td>
  <td class="short-link right-fade">
    <span class="table-field-label" aria-hidden="true">{{t "ui.short_link_domain"}}</span>
    <div class="short-link-wrapper" data-copy-container>
      <div class="clipboard small">
        <button 
          aria-label="{{t 'ui.copy'}}"
          data-ui-copy
          data-url="{{link.url}}"
        >
          {{> icons/copy}}
        </button>
        {{> icons/check}}
      </div>
      <a href="{{link.url}}">/{{link.address}}</a>
    </div>
    <p class="description">
      <button type="button" class="link-button" data-focus-after="#tab-links" aria-label="{{t 'ui.view_links_by_this_domain'}}"
        data-tooltip="{{t 'ui.view_links_by_this_domain'}}"
        hx-get="/api/links/admin"
        hx-target="closest table"
        hx-swap="outerHTML settle:0ms"
        hx-sync="this:replace"
        hx-vals='{"domain":"{{domain}}"}'
        hx-indicator="closest table"
      >{{domain}}</button>
    </p>
  </td>
  <td class="views">
    <span class="table-field-label" aria-hidden="true">{{t "ui.views"}}</span>
    {{visit_count}}
  </td>
    {{> admin/links/actions}}
</tr>
<tr class="edit">
  <td class="loading">
    {{> icons/spinner}}
  </td>
</tr>
