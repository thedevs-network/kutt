<div class="content create-user">
  <h2>{{t "ui.create_user"}}</h2>
  <form
    id="create-user-form"
    hx-post="/api/users/admin" 
    hx-target="closest .content" 
    hx-swap="outerHTML" 
    hx-indicator="closest .content"
  >
    <label class="{{#if errors.email}}error{{/if}}">
      {{t "ui.email_address"}}
      <input
        name="email"
        id="create-user-email"
        type="email"
        placeholder="{{t 'ui.email_address_2'}}"
        hx-preserve="true"
      />
      {{#if errors.email}}<p class="error">{{errors.email}}</p>{{/if}}
    </label>
    <label class="{{#if errors.password}}error{{/if}}">
      {{t "ui.password"}}
      <input
        name="password"
        id="create-user-password"
        type="password"
        placeholder="{{t 'ui.password_2'}}"
        hx-preserve="true"
        autocomplete="new-password"
      />
      {{#if errors.password}}<p class="error">{{errors.password}}</p>{{/if}}
    </label>
    <label class="{{#if errors.role}}error{{/if}}">
      {{t "ui.role"}}
      <select name="role" id="create-user-role" hx-preserve="true">
        <option value="USER" selected>{{t "ui.user"}}</option>
        {{#if canCreateLocalAdmin}}<option value="ADMIN">{{t "ui.admin"}}</option>{{/if}}
      </select>
      {{#if errors.role}}<p class="error">{{errors.role}}</p>{{/if}}
    </label>
    <div class="checkbox-wrapper">
      <label class="checkbox">
        <input 
          id="create-user-verified" 
          name="verified" 
          type="checkbox"
          data-ui-verification-email
          hx-preserve="true"
          checked
        />
        {{t "ui.verified"}}
      </label>
      <label class="checkbox">
        <input 
          id="create-user-banned" 
          name="banned"
          type="checkbox"
          data-ui-verification-email
          hx-preserve="true"
        />
        {{t "ui.banned"}}
      </label>
    </div>
    <label id="send-email-label" class="checkbox hidden" hx-preserve="true">
      <input id="create-user-send-email" name="verification_email" type="checkbox" />
      {{t "ui.send_verification_email"}}
    </label>
    <div class="buttons">
      <button type="button" data-ui-close-dialog>{{t "ui.cancel"}}</button>
      <button type="submit" class="primary">
        <span>{{> icons/new_user}}</span>
        {{t "ui.create"}}
      </button>
      {{> icons/spinner}}
    </div>
  </form>
  <div id="dialog-error">
    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}
  </div>
</div>
