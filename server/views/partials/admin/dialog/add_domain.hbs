<div class="content admin-create">
  <h2>{{t "ui.add_domain"}}</h2>
  <form
    id="add-domain-form"
    hx-post="/api/domains/admin" 
    hx-target="closest .content" 
    hx-swap="outerHTML" 
    hx-indicator="closest .content"
  >
    <label class="{{#if errors.address}}error{{/if}}">
      {{t "ui.address"}}
      <input
        name="address"
        id="add-domain-address"
        type="text"
        placeholder="{{t 'ui.address_2'}}"
        hx-preserve="true"
      />
      {{#if errors.address}}<p class="error">{{errors.address}}</p>{{/if}}
    </label>
    <label class="{{#if errors.homepage}}error{{/if}}">
      {{t "ui.homepage_optional"}}
      <input
        name="homepage"
        id="add-domain-homepage"
        type="text"
        placeholder="{{t 'ui.homepage_address'}}"
        hx-preserve="true"
      />
      {{#if errors.homepage}}<p class="error">{{errors.homepage}}</p>{{/if}}
    </label>
    <label class="checkbox">
      <input 
        id="add-domain-banned" 
        name="banned"
        type="checkbox"
        hx-preserve="true"
      />
      {{t "ui.banned"}}
    </label>
    <div class="buttons">
      <button type="button" data-ui-close-dialog>{{t "ui.cancel"}}</button>
      <button type="submit" class="primary">
        <span>{{> icons/plus}}</span>
        {{t "ui.add"}}
      </button>
      {{> icons/spinner}}
    </div>
  </form>
  <div id="dialog-error">
    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}
  </div>
</div>
