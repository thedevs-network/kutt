<form
  id="report-form"
  hx-post="/api/links/{id}/protected"
  hx-sync="this:abort"
  hx-ext="path-params"
  hx-vals='{"id":"{{id}}"}'
  hx-swap="outerHTML"
> 
  <input type="hidden" name="routing_query" value="{{routing_query}}" />
  <input type="hidden" name="suffix_path" value="{{suffix_path}}" />
  {{#if message}}
    <p class="success">{{message}}</p>
  {{else}}
    <div class="inputs-wrapper">
      <label>
        {{t "ui.password"}}
        <input 
          type="password" 
          id="protected-link-password" 
          name="password" 
          placeholder="{{t 'ui.password_2'}}"
          hx-preserve="true"
          class="{{#if errors.link}}error{{/if}}"
          required 
        />
      </label>
      <button type="submit" class="primary">
        <span>{{> icons/spinner}}</span>
        <span>{{> icons/key}}</span>
        {{t "ui.unlock_go"}}
      </button>
    </div>
    {{#if error}}<p class="error" data-error-field="password">{{error}}</p>{{/if}}
  {{/if}}
</form>
