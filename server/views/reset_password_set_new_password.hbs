{{> header}}
<section 
  id="new-password"
  class="section-container {{#unless token_verified}}verify-page{{/unless}}"
>
  {{#if token_verified}}
    <h2>
      {{t "ui.reset_password_2"}}
    </h2>
    <p>{{t "ui.set_your_new_password"}}</p>
    {{> reset_password/new_password_form}}
  {{else}}
    <h2>
      {{> icons/x}}
      {{t "ui.password_token_is_invalid_please_try_again"}}
    </h2>
    <a href="/reset-password" title="{{t 'ui.reset_password'}}">{{t "ui.reset_password_3"}}</a>
  {{/if}}
</section>
{{> footer}}