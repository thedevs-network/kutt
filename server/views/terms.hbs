{{> header}}
<section id="terms" class="section-container">
  <h3>{{t "terms.title" domain=default_domain}}</h3>
  <p>
    {{t "ui.by_accessing_the_website_at"}}
    <a href="https://{{default_domain}}">https://{{default_domain}}</a>{{t "ui.you_are_agreeing_to_be_bound_by_these_terms_of_service"}}
  </p>
  <p>
    {{t "ui.in_no_event_shall_value_or_its_suppliers_be_liable_for" value1=site_name value2=default_domain value3=site_name value4=site_name}}
  </p>
  <p>
    {{t "ui.the_materials_appearing_on_value_website_could_include_technical_typographical_or" value1=site_name value2=site_name value3=site_name value4=site_name}}
  </p>
  <p>
    {{t "ui.value_has_not_reviewed_all_of_the_sites_linked_to_its" value1=site_name value2=site_name}}
  </p>
  <p>
    {{t "ui.value_may_revise_these_terms_of_service_for_its_website_at" value1=site_name}}
  </p>
</section>
{{> footer}}
