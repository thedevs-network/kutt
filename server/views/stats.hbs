{{> header}}
<section
  id="stats-section"
  class="section-container"
  hx-get="/api/links/{id}/stats"
  hx-swap="innerHTML"
  hx-trigger="load once"
  data-stats-id="{{stats_id}}"
  hx-ext="path-params"
  data-ui-stats
>
  <div class="loading-stats">
    {{> icons/spinner}}
    {{t "ui.loading_stats"}}
  </div>
</section>
{{> footer}}
{{#extend "scripts"}}
  <script nonce="{{cspNonce}}" src="/libs/chart.min.js"></script>
  <script nonce="{{cspNonce}}" src="/scripts/chart-theme.js"></script>
  <script nonce="{{cspNonce}}" src="/scripts/stats.js"></script>
{{/extend}}
