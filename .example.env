# Optional - App port to run on
PORT=3000

# Optional - The name of the site where Kutt is hosted
SITE_NAME=Kutt

# Optional - The domain that this website is on
DEFAULT_DOMAIN=localhost:3000

# Optional separate management origin. HTTPS required outside development.
# Must use a distinct, unused hostname; never set this to a short domain.
# Empty preserves existing routes and custom-domain API behavior.
MANAGEMENT_ORIGIN=

# Required - Random long JWT signing secret; also derives webhook encryption keys.
# JWT payloads are signed, not encrypted. Preserve this secret with the database.
JWT_SECRET=

# Optional - Database client. Available clients for the supported databases:
# pg | better-sqlite3 | mysql2
# other supported drivers that you can use but you have to manually install them with npm:
# pg-native | sqlite3 | mysql
DB_CLIENT=better-sqlite3

# Optional - SQLite database file path
# Only if you're using SQLite
DB_FILENAME=db/data

# Optional - SQL database credential details
# Only if you're using Postgres or MySQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kutt
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# Verified TLS for pg/mysql2 requires a DNS DB_HOST matching the certificate.
# Optional custom CA and mutual TLS; uncomment only configured nonempty files.
# DB_SSL_CA_FILE=/run/secrets/database_ca
# DB_SSL_CERT_FILE=/run/secrets/database_client_cert
# DB_SSL_KEY_FILE=/run/secrets/database_client_key
# See docs/TRANSPORT-TLS.md. Never disable certificate or hostname verification.
DB_POOL_MIN=0
DB_POOL_MAX=10

# Optional - Generated link length
LINK_LENGTH=6

# Optional - Alphabet used to generate custom addresses
# Default value omits o, O, 0, i, I, l, 1, and j to avoid confusion when reading the URL
LINK_CUSTOM_ALPHABET=abcdefghkmnpqrstuvwxyzABCDEFGHKLMNPQRSTUVWXYZ23456789

# Optional - Tells the app that it's running behind a proxy server
# and that it should get the IP address from that proxy server
# if you're not using a proxy server then set this to false, otherwise users can override their IP address
TRUST_PROXY=false
# Prefer explicit trusted reverse-proxy IPs/CIDRs, e.g. peers:172.18.0.2,::1/128.
# Alternatively hops:1 (0..32), only when every path has the same proxy count.
# Legacy true/t/1 and false/f/0 remain booleans; "1" never means one hop.

# Optional document CSP. Stage custom templates in report-only before enforce.
# Browser diagnostics only; no report upload endpoint is configured.
# See docs/CSP.md for nonce helpers and custom asset compatibility.
CSP_MODE=off

# Optional - Redis host and port
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# The number for Redis database, between 0 and 15. Defaults to 0.
# If you don't know what this is, then you probably don't need to change it.
REDIS_DB=0
REDIS_SSL=false
# REDIS_SSL_CA_FILE=/run/secrets/redis_ca
# REDIS_SSL_CERT_FILE=/run/secrets/redis_client_cert
# REDIS_SSL_KEY_FILE=/run/secrets/redis_client_key

# Optional - Disable registration. Default is true.
DISALLOW_REGISTRATION=true

# Optional - Disable form-based login. Only makes sense when OIDC is enabled.
DISALLOW_LOGIN_FORM=false

# Optional - Disable anonymous link creation. Default is true.
DISALLOW_ANONYMOUS_LINKS=true

# Optional - This would be shown to the user on the settings page
# It's only for display purposes and has no other use
SERVER_IP_ADDRESS=
SERVER_CNAME_ADDRESS=

# Optional - Use HTTPS for links with custom domain
# It's on you to generate SSL certificates for those domains manually, at least on this version for now
CUSTOM_DOMAIN_USE_HTTPS=false

# Optional - Email is used to verify or change email address, reset password, and send reports.
# If it's disabled, all the above functionality would be disabled as well.
# MAIL_FROM example: "Kutt <support@kutt.to>". Leave it empty to use MAIL_USER.
# More info on the configuration on https://nodemailer.com/.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_FROM=
MAIL_PASSWORD=

# Optional - Enable rate limiting for management API routes.
# Protected-link password and report throttles remain enabled independently.
ENABLE_RATE_LIMIT=false

# Optional - JSON host allowlist for destinations. Blank disables the policy;
# [] denies all destinations. Exact hosts and *.domain subdomains are distinct.
# See docs/DESTINATION-POLICY.md; audit existing links before enabling.
DESTINATION_ALLOWED_HOSTS=

# Optional - Private performance listener; never publish this port to the internet.
# See docs/METRICS.md. Use a separate random token, preferably a protected file.
METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
METRICS_PORT=9101
METRICS_TOKEN=
# METRICS_TOKEN_FILE=/run/secrets/kutt_metrics_token

# Optional - The email address that will receive submitted reports
REPORT_EMAIL=

# Optional - Support email to show on the app
CONTACT_EMAIL=

# Optional - Log in with OIDC
OIDC_ENABLED=false
# Exact asymmetric algorithm for ID tokens and signed back-channel logout.
# Supported: RS256 (default), PS256, ES256, EdDSA. Never none or HMAC.
OIDC_ID_TOKEN_SIGNING_ALG=RS256
OIDC_ISSUER=
OIDC_PROMPT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
OIDC_EMAIL_CLAIM=email
# Leave OIDC_BUTTON_TEXT at its default for a localized sentence with this name.
OIDC_PROVIDER_NAME=OIDC
# A custom sentence remains verbatim for backward compatibility.
OIDC_BUTTON_TEXT=Log in with OIDC
# Delegated provisioning is separate from local signup. Existing emails never auto-link.
OIDC_ALLOW_REGISTRATION=true
# Absolute session lifetime; see docs/OIDC-SECURITY.md for migration and logout.
OIDC_SESSION_MAX_SECONDS=3600
# Optional explicit administrator mapping; default off. Read docs/OIDC-SECURITY.md first.
# Requires an active, verified local ADMIN with a tested password and NO OIDC binding.
OIDC_ADMIN_MAPPING_ENABLED=false
# One exact top-level ID-token claim (dots are literal, not nested traversal).
OIDC_ADMIN_CLAIM=
# JSON array of exact, case-sensitive strings, e.g. ["kutt-admin"].
OIDC_ADMIN_VALUES=
# Existing numeric user ID, not an email, username or provider subject.
OIDC_BREAK_GLASS_USER_ID=
# Maximum grant from signed iat, also capped by signed exp: 300/900/1800/3600.
OIDC_ADMIN_MAX_AGE_SECONDS=300

# Compose SQL examples only: explicitly select the existing database image.
# Never change database major versions on an existing volume without migration.
# POSTGRES_IMAGE=postgres:17-alpine
# MARIADB_IMAGE=mariadb:11.4
# MariaDB root secret is separate from DB_PASSWORD; use a private host file.
# MARIADB_ROOT_PASSWORD_FILE=/absolute/private/path/mariadb-root-password
